# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# Provide your MongoDB connection string (e.g., mongodb://localhost:27017/codealpha_store or Atlas URI)
# If left empty or connection cannot be established, the app will automatically spin up an in-memory MongoDB instance!
MONGODB_URI=mongodb://localhost:27017/codealpha_store

# JWT Authentication
JWT_SECRET=codealpha_super_secret_production_jwt_key_2026_9876543210
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3001
