# Server Configuration
PORT=3002
NODE_ENV=development

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas cluster)
# If left empty or connection is unavailable, CodeAlpha Social uses an in-memory document store fallback
MONGODB_URI=mongodb://localhost:27017/codealpha_social

# Security & Authentication
JWT_SECRET=codealpha_super_secret_jwt_key_2026_dev_secure_random
JWT_EXPIRES_IN=7d

# CORS & Uploads
CLIENT_URL=http://localhost:5000
MAX_FILE_SIZE_MB=5
